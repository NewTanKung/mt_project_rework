{% extends "user/layout.html" %}

{% block title %}การประชุม{% endblock %}

{% block extra_css %}
<style>
    .timer-display {
        font-size: 3rem;
        font-weight: bold;
        text-align: center;
        padding: 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 15px;
        margin-bottom: 2rem;
    }

    .control-button {
        min-width: 120px;
        font-size: 1.1rem;
        padding: 12px 24px;
    }

    .speaker-indicator {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: #6c757d;
        margin-left: 8px;
        transition: all 0.3s ease;
    }

    .speaker-indicator.speaking {
        background-color: #28a745;
        box-shadow: 0 0 10px #28a745;
        animation: pulse 1s infinite;
    }

    @keyframes pulse {

        0%,
        100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.2);
            opacity: 0.8;
        }
    }

    /* Participants Grid Layout */
    .participants-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 1rem;
        padding: 0.5rem;
    }

    .participant-card {
        background: #f8f9fa;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        padding: 1rem;
        text-align: center;
        transition: all 0.3s ease;
        position: relative;
    }

    .participant-card.speaking {
        background: #d4edda;
        border-color: #28a745;
        box-shadow: 0 0 15px rgba(40, 167, 69, 0.3);
    }

    .participant-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 0.5rem;
        font-size: 1.5rem;
        font-weight: bold;
        color: white;
        position: relative;
    }

    .participant-card.speaking .participant-avatar {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        animation: avatarPulse 1s infinite;
    }

    @keyframes avatarPulse {

        0%,
        100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }
    }

    .participant-name {
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
        color: #2c3e50;
    }

    .participant-channel {
        font-size: 0.75rem;
        color: #6c757d;
        margin-bottom: 0.25rem;
    }

    .participant-status {
        font-size: 0.7rem;
        color: #6c757d;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
    }

    .participant-card.speaking .participant-status {
        color: #28a745;
        font-weight: 600;
    }
</style>
{% endblock %}

{% block content %}
<div class="page-header">
    <h1>การบันทึกเสียงการประชุม</h1>
    <p class="text-muted-custom">เริ่มบันทึก หยุดชั่วคราว หรือสิ้นสุดการประชุม</p>
</div>

<!-- Alert Container -->
<div id="alertContainer"></div>

<!-- Meeting Info -->
<div class="card card-custom">
    <div class="card-header">
        <h5 class="mb-0">ข้อมูลการประชุม</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>ชื่อการประชุม:</strong> <span id="meetingName">-</span></p>
                <p><strong>วันที่:</strong> <span id="meetingDate">-</span></p>
            </div>
            <div class="col-md-6">
                <p><strong>สถานที่:</strong> <span id="meetingLocation">-</span></p>
                <p><strong>สถานะ:</strong> <span id="meetingStatus" class="badge">-</span></p>
            </div>
        </div>
    </div>
</div>

<!-- Timer -->
<div class="timer-display" id="timerDisplay">
    00:00:00
</div>

<!-- Control Buttons -->
<div class="text-center mb-4">
    <button class="btn btn-success control-button me-2" id="startBtn" onclick="startRecording()">
        เริ่มบันทึก
    </button>
    <button class="btn btn-warning control-button me-2 d-none" id="pauseBtn" onclick="pauseRecording()">
        หยุดชั่วคราว
    </button>
    <button class="btn btn-info control-button me-2 d-none" id="resumeBtn" onclick="resumeRecording()">
        ดำเนินการต่อ
    </button>
    <button class="btn btn-danger control-button d-none" id="stopBtn" onclick="stopRecording()">
        สิ้นสุดการประชุม
    </button>
</div>

<!-- Participants -->
<div class="card card-custom">
    <div class="card-header">
        <h5 class="mb-0">ผู้เข้าร่วม</h5>
    </div>
    <div class="card-body">
        <div id="participantsGrid" class="participants-grid">
            <div class="text-center text-muted-custom p-4">
                กำลังโหลด...
            </div>
        </div>
    </div>
</div>

<!-- Select Meeting Modal -->
<div class="modal fade" id="selectMeetingModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">เลือกการประชุม</h5>
            </div>
            <div class="modal-body">
                <p>เลือกการประชุมที่ลงทะเบียนไว้</p>
                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>ชื่อการประชุม</th>
                                <th>วันที่</th>
                                <th>สถานะ</th>
                                <th>เลือก</th>
                            </tr>
                        </thead>
                        <tbody id="meetingsTableBody">
                            <tr>
                                <td colspan="4" class="text-center">กำลังโหลด...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <a href="/user/register" class="btn btn-primary">
                    ลงทะเบียนการประชุมใหม่
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
    let currentMeeting = null;
    let timerInterval = null;
    let elapsedSeconds = 0;
    let selectModal = null;

    document.addEventListener('DOMContentLoaded', async () => {
        // Initialize modal
        selectModal = new bootstrap.Modal(document.getElementById('selectMeetingModal'));

        // Auto-sync devices on page load
        await autoSyncDevices();

        // Load registered meetings
        loadRegisteredMeetings();
    });

    // Auto-sync devices
    async function autoSyncDevices() {
        try {
            const response = await fetch('/api/user/devices/sync', {
                method: 'POST'
            });
            const data = await response.json();

            if (data.success) {
                if (data.updates.length > 0) {
                    // แสดงการอัปเดต
                    showDeviceSyncNotification(data.updates);
                }

                if (data.missing.length > 0) {
                    // แสดงเตือนว่ามีอุปกรณ์หาย
                    showMissingDevicesWarning(data.missing);
                }
            }
        } catch (error) {
            console.error('Auto-sync failed:', error);
        }
    }

    function showDeviceSyncNotification(updates) {
        const message = updates.map(u =>
            `✅ ${u.name}: อัปเดต index ${u.old_index} → ${u.new_index}`
        ).join('<br>');

        showAlert(`อัปเดตอุปกรณ์อัตโนมัติ:<br>${message}`, 'info');
    }

    function showMissingDevicesWarning(missing) {
        const message = missing.map(m =>
            `⚠️ ${m.name} (Index: ${m.index})`
        ).join('<br>');

        showAlert(`อุปกรณ์ต่อไปนี้ไม่พบในเครื่อง:<br>${message}`, 'warning');
    }

    // Load registered meetings
    async function loadRegisteredMeetings() {
        try {
            const response = await fetch('/api/user/meetings?status=registered');
            const data = await response.json();

            if (data.meetings.length === 0) {
                showAlert('ไม่มีการประชุมที่ลงทะเบียนไว้', 'warning');
                setTimeout(() => {
                    window.location.href = '/user/register';
                }, 2000);
                return;
            }

            renderMeetingsList(data.meetings);
            selectModal.show();
        } catch (error) {
            showAlert('ไม่สามารถโหลดข้อมูลได้', 'danger');
        }
    }

    // Render meetings list
    function renderMeetingsList(meetings) {
        const tbody = document.getElementById('meetingsTableBody');
        tbody.innerHTML = meetings.map(m => `
        <tr>
            <td>${m.meeting_name}</td>
            <td>${m.meeting_date}</td>
            <td>
                <span class="badge badge-custom ${getStatusClass(m.status)}">
                    ${getStatusText(m.status)}
                </span>
            </td>
            <td>
                <button class="btn btn-sm btn-primary" onclick="selectMeeting(${m.meeting_id})">
                    เลือก
                </button>
            </td>
        </tr>
    `).join('');
    }

    // Select meeting
    async function selectMeeting(meetingId) {
        try {
            const response = await fetch(`/api/user/meetings/${meetingId}`);
            const data = await response.json();

            if (data.meeting) {
                currentMeeting = data.meeting;
                displayMeeting();
                selectModal.hide();
            }
        } catch (error) {
            showAlert('ไม่สามารถโหลดข้อมูลได้', 'danger');
        }
    }

    // Display meeting
    function displayMeeting() {
        document.getElementById('meetingName').textContent = currentMeeting.meeting_name;
        document.getElementById('meetingDate').textContent = currentMeeting.meeting_date;
        document.getElementById('meetingLocation').textContent = currentMeeting.meeting_location || '-';

        updateStatusDisplay(currentMeeting.status);

        // Display participants with speaker indicators
        renderParticipants();
    }

    // Render participants    // Render participants with speaker indicators
    function renderParticipants() {
        const grid = document.getElementById('participantsGrid');

        if (!currentMeeting || !currentMeeting.participants || currentMeeting.participants.length === 0) {
            grid.innerHTML = '<div class="text-center text-muted-custom p-4">ไม่มีผู้เข้าร่วม</div>';
            return;
        }

        grid.innerHTML = currentMeeting.participants.map(p => {
            // Get initials for avatar
            const initials = p.participant_name
                .split(' ')
                .map(n => n[0])
                .join('')
                .toUpperCase()
                .substring(0, 2);

            return `
            <div class="participant-card" id="participant-${p.person_id}">
                <div class="participant-avatar">
                    ${initials}
                </div>
                <div class="participant-name">${p.participant_name}</div>
                <div class="participant-channel">${p.channel_name || '-'}</div>
                <div class="participant-status">
                    <span class="status-text">ไม่พูด</span>
                    <span class="speaker-indicator" id="indicator-${p.person_id}"></span>
                </div>
            </div>
        `}).join('');
    }

    // Update status display
    function updateStatusDisplay(status) {
        const badge = document.getElementById('meetingStatus');
        badge.className = `badge badge-custom ${getStatusClass(status)}`;
        badge.textContent = getStatusText(status);
    }

    // Start recording
    async function startRecording() {
        if (!currentMeeting) return;

        try {
            const response = await fetch(`/api/user/meetings/${currentMeeting.meeting_id}/start`, {
                method: 'POST'
            });
            const data = await response.json();

            if (data.success) {
                showAlert('เริ่มบันทึกเสียงแล้ว', 'success');
                updateStatusDisplay('recording');
                updateButtons('recording');
                startTimer();
                startSpeakerDetection(); // เริ่มตรวจจับผู้พูด
            }
        } catch (error) {
            showAlert('ไม่สามารถเริ่มบันทึกได้', 'danger');
        }
    }

    // Pause recording
    async function pauseRecording() {
        if (!currentMeeting) return;

        try {
            const response = await fetch(`/api/user/meetings/${currentMeeting.meeting_id}/pause`, {
                method: 'POST'
            });
            const data = await response.json();

            if (data.success) {
                showAlert('หยุดชั่วคราว', 'info');
                updateStatusDisplay('paused');
                updateButtons('paused');
                pauseTimer();
            }
        } catch (error) {
            showAlert('เกิดข้อผิดพลาด', 'danger');
        }
    }

    // Resume recording
    async function resumeRecording() {
        if (!currentMeeting) return;

        try {
            const response = await fetch(`/api/user/meetings/${currentMeeting.meeting_id}/resume`, {
                method: 'POST'
            });
            const data = await response.json();

            if (data.success) {
                showAlert('ดำเนินการต่อ', 'success');
                updateStatusDisplay('recording');
                updateButtons('recording');
                startTimer();
            }
        } catch (error) {
            showAlert('เกิดข้อผิดพลาด', 'danger');
        }
    }

    // Stop recording
    async function stopRecording() {
        if (!currentMeeting) return;

        if (!confirm('ต้องการสิ้นสุดการประชุมหรือไม่?')) return;

        try {
            const response = await fetch(`/api/user/meetings/${currentMeeting.meeting_id}/stop`, {
                method: 'POST'
            });
            const data = await response.json();

            if (data.success) {
                showAlert('สิ้นสุดการประชุมแล้ว', 'success');
                updateStatusDisplay('completed');
                updateButtons('completed');
                pauseTimer();

                setTimeout(() => {
                    window.location.href = '/user/manage';
                }, 2000);
            }
        } catch (error) {
            showAlert('เกิดข้อผิดพลาด', 'danger');
        }
    }

    // Timer functions
    function startTimer() {
        if (timerInterval) return;

        timerInterval = setInterval(() => {
            elapsedSeconds++;
            updateTimerDisplay();
        }, 1000);
    }

    function pauseTimer() {
        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }
    }

    function updateTimerDisplay() {
        const hours = Math.floor(elapsedSeconds / 3600);
        const minutes = Math.floor((elapsedSeconds % 3600) / 60);
        const seconds = elapsedSeconds % 60;

        const display = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;
        document.getElementById('timerDisplay').textContent = display;
    }

    function pad(num) {
        return num.toString().padStart(2, '0');
    }

    // Update button visibility
    function updateButtons(status) {
        const startBtn = document.getElementById('startBtn');
        const pauseBtn = document.getElementById('pauseBtn');
        const resumeBtn = document.getElementById('resumeBtn');
        const stopBtn = document.getElementById('stopBtn');

        startBtn.classList.add('d-none');
        pauseBtn.classList.add('d-none');
        resumeBtn.classList.add('d-none');
        stopBtn.classList.add('d-none');

        if (status === 'registered') {
            startBtn.classList.remove('d-none');
        } else if (status === 'recording') {
            pauseBtn.classList.remove('d-none');
            stopBtn.classList.remove('d-none');
        } else if (status === 'paused') {
            resumeBtn.classList.remove('d-none');
            stopBtn.classList.remove('d-none');
        }
    }

    // Helper functions
    function getStatusClass(status) {
        const classes = {
            'registered': 'bg-info',
            'recording': 'bg-danger',
            'paused': 'bg-warning',
            'completed': 'bg-success'
        };
        return classes[status] || 'bg-secondary';
    }

    function getStatusText(status) {
        const texts = {
            'registered': 'ลงทะเบียนแล้ว',
            'recording': 'กำลังบันทึก',
            'paused': 'หยุดชั่วคราว',
            'completed': 'เสร็จสิ้น'
        };
        return texts[status] || status;
    }

    // Speaker Detection
    let speakerDetectionInterval = null;

    function startSpeakerDetection() {
        if (!currentMeeting) return;

        // Fetch real speaker activity from recording service
        speakerDetectionInterval = setInterval(() => {
            fetchRealSpeakerActivity();
        }, 500); // Update every 500ms
    }

    function stopSpeakerDetection() {
        if (speakerDetectionInterval) {
            clearInterval(speakerDetectionInterval);
            speakerDetectionInterval = null;

            // Reset all indicators
            if (currentMeeting && currentMeeting.participants) {
                currentMeeting.participants.forEach(p => {
                    updateSpeakerStatus(p.person_id, false);
                });
            }
        }
    }

    async function fetchRealSpeakerActivity() {
        if (!currentMeeting) return;

        try {
            const response = await fetch(`/api/user/meetings/${currentMeeting.meeting_id}/audio-levels`);
            const data = await response.json();

            console.log('[Speaker Detection] Audio levels:', data);

            if (data.success) {
                const threshold = 0.05;  // Same as RMS threshold in recording service

                currentMeeting.participants.forEach(participant => {
                    const level = data.levels[participant.person_id] || 0;
                    const isSpeaking = level > threshold;

                    console.log(`[Speaker] Participant ${participant.person_id} (${participant.name}): RMS=${level.toFixed(4)}, Speaking=${isSpeaking}`);

                    updateSpeakerStatus(participant.person_id, isSpeaking);
                });
            }
        } catch (error) {
            console.error('Error fetching audio levels:', error);
        }
    }

    function updateSpeakerStatus(personId, isSpeaking) {
        const indicator = document.getElementById(`indicator-${personId}`);
        const row = document.getElementById(`participant-${personId}`);

        if (!indicator || !row) return;

        const statusText = row.querySelector('.speaker-status-text');

        if (isSpeaking) {
            indicator.classList.add('speaking');
            if (statusText) statusText.textContent = '🎤 กำลังพูด';
            row.style.backgroundColor = '#d4edda'; // Light green background
        } else {
            indicator.classList.remove('speaking');
            if (statusText) statusText.textContent = 'ไม่พูด';
            row.style.backgroundColor = ''; // Reset background
        }
    }

    // Update pause/resume/stop to handle speaker detection
    const originalPauseRecording = pauseRecording;
    pauseRecording = async function () {
        await originalPauseRecording();
        stopSpeakerDetection();
    };

    const originalResumeRecording = resumeRecording;
    resumeRecording = async function () {
        await originalResumeRecording();
        startSpeakerDetection();
    };

    const originalStopRecording = stopRecording;
    stopRecording = async function () {
        stopSpeakerDetection();
        await originalStopRecording();
    };
</script>
{% endblock %}